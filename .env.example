HOST=127.0.0.1
PORT=3000
# Initial Euclidean threshold only. Calibrate on separate consented captures.
FACE_MATCH_THRESHOLD=0.6
# Day 2 experimental landmark thresholds. Calibrate on real, consented captures.
LIVENESS_TIMEOUT_MS=60000
LIVENESS_STEP_TIMEOUT_MS=20000
LIVENESS_EYE_OPEN=0.25
# Head tilt (roll) in degrees relative to the user's own neutral pose.
LIVENESS_HEAD_TILT_DEG=12
LIVENESS_HEAD_LEVEL_DEG=6
LIVENESS_HEAD_TURN=0.15
LIVENESS_HEAD_CENTER=0.10
# Encrypted template store. Without TEMPLATE_KEY a random key is created in DATA_DIR/template.key.
DATA_DIR=data
# TEMPLATE_KEY=<64 hex characters>
